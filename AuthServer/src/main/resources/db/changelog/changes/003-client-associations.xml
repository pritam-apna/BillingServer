<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="3" author="system">
        <addColumn tableName="users">
            <column name="email" type="VARCHAR(255)"/>
            <column name="phone" type="VARCHAR(50)"/>
        </addColumn>
    </changeSet>

    <changeSet id="4" author="system">
        <createTable tableName="user_authorized_clients">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_user_auth_clients_user" referencedTableName="users" referencedColumnNames="id" deleteCascade="true"/>
            </column>
            <column name="client_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="user_authorized_clients" columnNames="user_id, client_id"/>
    </changeSet>

    <changeSet id="5" author="system">
        <sql>
            -- Authorize 'admin' for all seeded clients
            INSERT INTO user_authorized_clients (user_id, client_id) VALUES (1, 'billing-client') ON CONFLICT DO NOTHING;
            INSERT INTO user_authorized_clients (user_id, client_id) VALUES (1, 'inventory-client') ON CONFLICT DO NOTHING;
        </sql>
    </changeSet>

</databaseChangeLog>
